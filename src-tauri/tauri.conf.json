{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutsumi Mail",
  "version": "0.1.1",
  "identifier": "moe.mutsumi.mail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mutsumi Mail",
        "width": 1320,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; frame-src 'self' about: blob:; object-src blob:; style-src 'self' 'unsafe-inline' https: http:; font-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
